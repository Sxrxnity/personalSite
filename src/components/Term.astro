---
// Bold text in an article. When it names a term from data/definitions.ts ("First principles", "It's physics."), its
// definition pops up on hover, or on tap/focus; any other bold text is left as it is.
import { definitions } from '../data/definitions';

// lower case, letters and spaces only, without a leading "it's" or a plural s: "It's physics." → "physic"
const key = (s: string) => s.toLowerCase().replace(/<[^>]*>|[^a-z ]/g, "").trim().replace(/^its /, "").replace(/s$/, "");
const html = await Astro.slots.render('default');
const def = definitions.flat().find((d) => key(d.term) === key(html));
---
{def ? (
  <span class="term" tabindex="0">
    <strong set:html={html} />
    <span class="tip" role="tooltip"><b>{def.term}</b>: <span set:html={def.meaning} /></span>
  </span>
) : <strong set:html={html} />}

<style>
  .term {
    position: relative;
    cursor: help;
    text-decoration: underline dotted var(--accent);
    text-underline-offset: 0.2em;
  }
  /* ponytail: always opens below and to the right, so a term at the far right edge can push past the screen */
  .tip {
    display: none;
    position: absolute;
    left: 0;
    top: calc(100% + 0.4rem);
    z-index: 10;
    width: max-content;
    max-width: min(18rem, calc(100vw - 2rem));
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--accent);
    background: var(--paper);
    font-size: 0.85rem;
    font-style: normal;
    font-weight: normal;
    line-height: 1.4;
  }
  .term:hover .tip,
  .term:focus .tip { display: block; }
</style>
