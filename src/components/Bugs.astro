{[["/media/", "Media", "#4f7fc4"], ["/music/", "Music", "#8a5fbf"]].map(([href, label, wing]) => (
  <a class="bug" href={href} aria-label={label} style={`--wing: ${wing}`}>
    <svg viewBox="0 0 40 40" aria-hidden="true">
      <ellipse class="wing left" cx="12" cy="19" rx="9" ry="5" />
      <ellipse class="wing right" cx="28" cy="19" rx="9" ry="5" />
      <ellipse class="body" cx="20" cy="23" rx="4" ry="9" />
      <circle class="body" cx="20" cy="12" r="3.5" />
      <path class="feelers" d="M18.5 9 Q17 4 13 3 M21.5 9 Q23 4 27 3" />
    </svg>
  </a>
))}

<script>
  // Little bugs wander the page in lazy arcs (each one's turn rate drifts slowly at random), turning back
  // toward the middle whenever they near an edge. Each is a link (to Media, Music), and holds still under the
  // pointer so it can be caught.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const top = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--bar-h"));
  const SIZE = 36, SPEED = 0.08, EDGE = 120; // px, px per ms, px
  document.querySelectorAll<HTMLElement>(".bug").forEach((bug, n) => {
    let x = innerWidth * (n ? 0.2 : 0.8), y = innerHeight * 0.7, heading = Math.random() * 2 * Math.PI, turn = 0;
    let held = false, then = 0;
    const place = () => bug.style.transform =
      `translate(${x - SIZE / 2}px, ${y - SIZE / 2}px) rotate(${heading + Math.PI / 2}rad)`;
    bug.addEventListener("pointerenter", () => held = true);
    bug.addEventListener("pointerleave", () => held = false);
    const fly = (now: number) => {
      const dt = Math.min(now - then, 50); // no leap after the tab was hidden
      then = now;
      if (!held) {
        turn = (turn + (Math.random() - 0.5) * 0.004) * 0.98; // radians per frame, nudged then eased back
        heading += turn;
        if (x < EDGE || x > innerWidth - EDGE || y < top + EDGE || y > innerHeight - EDGE) {
          const home = Math.atan2(innerHeight / 2 - y, innerWidth / 2 - x);
          heading += Math.sin(home - heading) * 0.04;
        }
        x += Math.cos(heading) * SPEED * dt;
        y += Math.sin(heading) * SPEED * dt;
        place();
      }
      requestAnimationFrame(fly);
    };
    place();
    if (!reduce) requestAnimationFrame((now) => { then = now; fly(now); });
  });
</script>

<style>
  .bug { position: fixed; top: 0; left: 0; z-index: 5; width: 36px; height: 36px; }
  .bug svg { display: block; width: 100%; height: 100%; }
  .bug .body { fill: var(--ink); }
  .bug .feelers { fill: none; stroke: var(--ink); stroke-width: 1.2; stroke-linecap: round; }
  .bug .wing { fill: var(--wing); opacity: 0.45; stroke: var(--wing); transform-box: fill-box; }
  .bug .left { transform-origin: right center; }
  .bug .right { transform-origin: left center; }
  .bug:hover .wing, .bug:focus-visible .wing { opacity: 0.8; }
  @media (prefers-reduced-motion: no-preference) {
    .bug .wing { animation: flap 0.12s ease-in-out infinite alternate; }
  }
  @keyframes flap { to { transform: scaleX(0.35); } }
</style>
