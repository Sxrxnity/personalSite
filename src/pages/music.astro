          ["Thermodynamix", "Acheron"], ["Time Leaper", "Falling Up"],
        ],
        "Custom Levels": [
          "Cherry Blossoms", "Explorers", "Far Fetched - Into the Woods!", "Geometry Dash Gangster Rap", "He's a Pirate",
          "Lost Memory", "Lunar Abyss", "Milkshake", "Press Start", "Slash Inferno", "Stay Inside Me", "The Maze of Mayonnaise",
          "What's a Future Funk?",
        ],
      } },
      { title: "Hans Zimmer", search: "Hans Zimmer", cover: "hans-zimmer.jpg", songs: { // cover: "Hans Zimmer in 2022" by Raph_PH, CC BY 2.0, via Wikimedia Commons
        "F1": ["F1"],
        "Inception": ["Time"],
        "Interstellar": ["Cornfield Chase", "Day One", "No Time for Caution", "Stay"],
        "Kung Fu Panda": ["Oogway Ascends"],
