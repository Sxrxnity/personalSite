          ["戦線", "Front Line"],
          ["最強の挑戦者", "The Strongest Challenger"],
          ["月夕", "Moonlit Evening"],
          ["ハーケン", "Piton"],
          ["脅迫(しんらい)", "The Threat of Trust"],
          ["バケモンたちの宴", "Monsters' Banquet"],
        ],
        "The Dumpster Battle (Movie)": [
          ["ゴミ捨て場の決戦", "The Dumpster Battle"],
          ["猫の爪", "Cat's Claws"],
