---
import Layout from '../layouts/Layout.astro';
import MediaGrid, { type Group, type Song } from '../components/MediaGrid.astro';

// Playlists, one per feeling: title, an optional one-line blurb, the songs in it, and optionally a square cover in
// public/media-covers/. Clicking one pops its songs up. Order here doesn't matter: albums and their songs are
// shown alphabetically, songs given as [original, english] by the english, and headed lists by heading.
const groups: Group[] = [
