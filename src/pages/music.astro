      { title: "Mario OST", searchHeadings: true, cover: "mario-ost.jpg", songs: { // cover: Super Mario Odyssey box art
        "Super Mario Odyssey": ["Jump Up, Super Star!", "New Donk City", "New Donk City Café", "Steam Gardens"],
        "Super Mario Galaxy": ["Comet Observatory", "Gusty Garden Galaxy", "Rosalina in the Observatory"],
        "Super Mario 3D World": ["A Boss Approaches"],
