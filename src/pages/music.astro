// Albums sit on shelves, in this order; each album's title must be on exactly one shelf.
const shelves: Record<string, string[]> = {
  "Pop": ["20th Century Classics", "2000s Pop", "2010s Pop", "2020s Pop", "Rap"],
  "Asian Pop": ["C-Pop", "K-Pop", "Japanese", "JJ Lin", "YOASOBI", "等什么君", "汪苏泷"],
  "Film & TV": ["Haikyuu OST", "Hans Zimmer", "Ludwig Göransson", "Squid Game OST"],
  "Game OSTs": ["Dragon Age: Inquisition", "Geometry Dash", "Jake Rivers", "Mario OST", "Minecraft OST", "PvZ OST", "Tetris", "Toby Fox"],
  "Electronic": ["Alan Walker", "Kirara Magic", "TheFatRat", "Xomu"],
  "Classical & Epic": ["Orchestra", "Piano", "Samuel Kim", "Two Steps from Hell"],
  "Fantasy & Medieval": [
    "Adrian von Ziegler", "Adriel Fair", "Alexander Nakarada", "BrunuhVille", "Ciara Quinn", "Enchanting", "MightyW Project",
    "Peter Crowley", "Peter Gundry", "The Fiechters",
  ],
};
const shelved = Object.values(shelves).flat();
const lost = albums.filter((a) => shelved.filter((t) => t === a.title).length !== 1).map((a) => a.title);
if (lost.length || shelved.length !== albums.length) throw new Error(`albums not on exactly one shelf: ${lost.join(", ")}`);
const groups: Group[] = Object.entries(shelves).map(([title, names]) => ({
  title, search: "music", shape: "square", items: names.map((n) => albums.find((a) => a.title === n)!),
}));
const abc = (a: string, b: string) => a.localeCompare(b, "en", { numeric: true });
const english = (s: Song) => (typeof s === "string" ? s : s[1]);
for (const g of groups) {
  g.items.sort((a, b) => abc(a.title, b.title));
  for (const item of g.items) {
    const sortSongs = (songs: Song[]) => songs.sort((a, b) => abc(english(a), english(b)));
    if (Array.isArray(item.songs)) sortSongs(item.songs);
    else if (item.songs) item.songs = Object.fromEntries(
      Object.entries(item.songs).sort(([a], [b]) => abc(a, b)).map(([h, songs]) => [h, sortSongs(songs)]));
  }
}
// the shelves sit around a drum, each face tilted one step from the last and pushed out far enough that they meet edge to
// edge; FACE is a shelf's height in rem: its heading and row of tiles, centred, with space to spare between shelves
const FACE = 15;
const radius = FACE / 2 / Math.tan(Math.PI / groups.length);
---
<Layout title="Music" hidden back={["/interests/", "Interests"]}>
  <p class="lede">Easter egg! For when you want to explore different feelings.</p>
  <div class="albums" style={`--faces: ${groups.length}; --face: ${FACE}rem; --radius: ${radius}rem; --at: 0`}>
    <nav class="shelves" aria-label="Shelves">
      {groups.map((g, i) => <button type="button" data-to={i} aria-current={i === 0 ? "true" : undefined}>{g.title}</button>)}
    </nav>
    <div class="frame">
    <div class="stage" tabindex="0" aria-label="Shelves wheel: scroll, swipe or use the arrow keys to turn it">
      <div class="drum">
        {groups.map((g, i) => (
          <section class="face" style={`--i: ${i}`} data-face={i} aria-hidden={i === 0 ? undefined : "true"}>
            <MediaGrid groups={[g]} id={`shelf${i}`} />
          </section>
        ))}
      </div>
    </div>
    </div>
  </div>
</Layout>

<script>
  // The drum turns slowly and constantly on its own. Mouse wheel or trackpad, a vertical swipe, the arrow keys, a
  // shelf's name, or clicking a shelf peeking above or below rolls it a shelf at a time. It wraps around, like a real
  // wheel. Without this script the shelves just stack down the page.
  const albums = document.querySelector<HTMLElement>(".albums")!;
  const stage = albums.querySelector<HTMLElement>(".stage")!;
  const frame = albums.querySelector<HTMLElement>(".frame")!; // only hovering the wheel itself holds it, not the shelf names
  const faces = [...albums.querySelectorAll<HTMLElement>(".face")];
  const names = [...albums.querySelectorAll<HTMLButtonElement>(".shelves button")];
  const SPEED = 1 / 5; // shelves per second while drifting
  // pos is how far round it is, in shelves, unbounded, so going past the last one keeps rolling forward rather than
  // spinning back; target is a whole shelf it's rolling to, once you've turned it or while it holds still for you
  let pos = 0, target: number | null = null, front = -1;
  const at = () => ((Math.round(pos) % faces.length) + faces.length) % faces.length;
  const turn = (by: number) => { target = Math.round(target ?? pos) + by; touchedAt = performance.now(); };

  // it holds still while you're over it, focused in it, reading a pop-up, or for a while after you've turned it;
  // and never drifts for anyone who has asked for less motion
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  let touchedAt = -Infinity, last = performance.now();
  requestAnimationFrame(function tick(now) {
    const dt = Math.min((now - last) / 1000, 0.1);
    last = now;
    const busy = frame.matches(":hover, :focus-within") || albums.querySelector("dialog[open]")
      || now - touchedAt < 2500 || still.matches;
    if (busy && target === null) target = Math.round(pos); // settle the nearest shelf square to the front
    if (target !== null) {
      pos += (target - pos) * (still.matches ? 1 : Math.min(1, dt * 7)); // ease in, quick then gentle
      if (Math.abs(target - pos) < 0.001) pos = target;
      if (pos === target && !busy) target = null;
    } else pos += SPEED * dt;
    albums.style.setProperty("--at", String(pos));
    if (at() !== front) {
      front = at();
      faces.forEach((f, i) => {
        f.toggleAttribute("inert", i !== front);
        f.toggleAttribute("aria-hidden", i !== front);
        f.classList.toggle("front", i === front);
      });
      names.forEach((b, i) => b.toggleAttribute("aria-current", i === front));
    }
    requestAnimationFrame(tick);
  });
  albums.classList.add("wheel");

  // arrows on a shelf with more albums off to the side, shown only on the side there's more to see
  for (const face of faces) {
    const row = face.querySelector<HTMLElement>(".picks")!;
    const arrows = ([-1, 1] as const).map((dir) => {
      const arrow = document.createElement("button");
      arrow.type = "button";
      arrow.className = `more ${dir < 0 ? "back" : "on"}`;
      arrow.textContent = dir < 0 ? "‹" : "›";
      arrow.setAttribute("aria-label", dir < 0 ? "Earlier albums" : "More albums");
      arrow.addEventListener("click", () => row.scrollBy({ left: dir * row.clientWidth * 0.8, behavior: "smooth" }));
      face.append(arrow);
      return arrow;
    });
    const show = () => {
      for (const arrow of arrows) arrow.style.top = `${row.offsetTop + row.clientHeight / 2}px`;
      arrows[0].hidden = row.scrollLeft < 2;
      arrows[1].hidden = row.scrollLeft + row.clientWidth > row.scrollWidth - 2;
    };
    row.addEventListener("scroll", show, { passive: true });
    addEventListener("resize", show);
    show();
  }

  names.forEach((b, i) => b.addEventListener("click", () => {
    const ahead = (i - at() + faces.length) % faces.length; // take the short way round
    target = Math.round(pos) + (ahead > faces.length / 2 ? ahead - faces.length : ahead);
    touchedAt = performance.now();
  }));
  // a shelf peeking out is inert, so catch its clicks on the stage and roll it to the front
  stage.addEventListener("click", (e) => {
    if (albums.querySelector(".face.front")?.contains(e.target as Node)) return;
    const y = e.clientY - stage.getBoundingClientRect().top;
    turn(y < stage.clientHeight / 2 ? -1 : 1);
  });
  let wheelAt = 0, lockedUntil = 0;
  stage.addEventListener("wheel", (e) => {
    if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return; // leave sideways scrolling to the shelf
    e.preventDefault();
    wheelAt += e.deltaY;
    if (Math.abs(wheelAt) < 40 || performance.now() < lockedUntil) return;
    turn(Math.sign(wheelAt));
    wheelAt = 0;
    lockedUntil = performance.now() + 450; // one notch per flick, however many events a trackpad sends
  }, { passive: false });
  let touchY: number | null = null;
  stage.addEventListener("touchstart", (e) => { touchY = e.touches[0].clientY; touchedAt = performance.now(); }, { passive: true });
  stage.addEventListener("touchend", (e) => {
    if (touchY === null) return;
    const dy = touchY - e.changedTouches[0].clientY;
    if (Math.abs(dy) > 40) turn(Math.sign(dy));
    touchY = null;
  });
  stage.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
    e.preventDefault();
    turn(e.key === "ArrowDown" ? 1 : -1);
  });
</script>

<style>
  .lede { line-height: 1.7; text-wrap: pretty; }
  /* each shelf is one row of tiles a quarter bigger than the ~7.2rem ones the shared grid uses */
  .albums :global(.picks) { display: flex; gap: 0.6rem; overflow-x: auto; scrollbar-width: thin; padding-bottom: 0.4rem; }
  .albums :global(.picks > li) { flex: 0 0 9rem; }
  .shelves { display: none; }

  .wheel .shelves { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 3rem; } /* clear of the shelf peeking over the top */
  .shelves button {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--wash);
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .shelves button:hover { border-color: var(--accent); }
  .shelves button[aria-current] { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  /* a frame round the wheel, so it's clear where scrolling turns it */
  .wheel .frame {
    padding: 0 1.75rem;
    border: 1px solid var(--wash);
    border-radius: 12px;
    background: color-mix(in srgb, var(--ink) 3%, transparent);
    transition: border-color 0.3s;
  }
  .wheel .frame:hover, .wheel .frame:focus-within { border-color: var(--accent); }
  /* on wider screens the frame reaches out past the page column, so the shelves keep its full width */
  @media (min-width: 52rem) { .wheel .frame { margin-inline: -1.75rem; } }
  /* the drum: faces stand round its edge, and turning it brings face --at to the front */
  .wheel .stage {
    position: relative;
    height: calc(var(--face) * 2.4); /* room for the front shelf to sit clear of the fades */
    perspective: 70rem;
    outline-offset: 0.5rem;
    /* the shelves fade as they roll away over the top and bottom */
    mask-image: linear-gradient(transparent, #000 18%, #000 82%, transparent);
  }
  .wheel .drum {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--radius) * -1)) rotateX(calc(var(--at) * 360deg / var(--faces)));
  }
  .wheel .face {
    position: absolute;
    inset: 50% 0 auto;
    height: var(--face);
    margin-top: calc(var(--face) / -2);
    backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transform: rotateX(calc(var(--i) * -360deg / var(--faces))) translateZ(var(--radius));
    opacity: 0.35;
    transition: opacity 0.8s;
    cursor: pointer;
  }
  .wheel .face.front { opacity: 1; cursor: auto; }
  .wheel .face :global(h2) { margin-top: 0; text-align: center; }
  /* made by the script, so out of reach of scoped styles */
  .albums :global(.more) {
    position: absolute;
    translate: 0 -50%;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--wash);
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    color: var(--ink);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.25);
  }
  .albums :global(.more:hover) { color: var(--accent); }
  .albums :global(.more[hidden]) { display: none; }
  .albums :global(.more.back) { left: -0.75rem; }
  .albums :global(.more.on) { right: -0.75rem; }
  @media (prefers-reduced-motion: reduce) {
    .wheel .face { transition: none; }
  }
</style>
