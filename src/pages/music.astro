      { title: "Orchestra", searchHeadings: true, cover: "orchestra.jpg", songs: { // cover: London Symphony Orchestra at the Barbican by FA2010, public domain, via Wikimedia Commons
        "Brahms": ["Hungarian Dance No. 5"],
        "Dvořák": ["Symphony No. 9 \"From the New World\""],
        "Holst": ["Jupiter, the Bringer of Jollity"],
        "Leontovych": ["Carol of the Bells (Epic Version)"],
        "Mahler": ["Symphony No. 4"],
        "Monti": ["Czardas"],
        "Mozart": ["Lacrimosa (Epic Version)"],
        "Shostakovich": ["5 Pieces for 2 Violins and Piano", "Waltz No. 2"],
        "Tchaikovsky": ["Waltz of the Flowers"],
        "Tony Ann": ["ICARUS (Orchestral Version)"],
        "Vivaldi": ["Summer", "Winter"],
      } },
      { title: "Squid Game OST", search: "Squid Game", cover: "squid-game-ost.jpg", songs: { // cover: Squid Game (Original Soundtrack from the Netflix Series)
        "Season 1": ["Needles and Dalgona"],
        "Season 2": ["Way Forward"],
      } },
      { title: "The Fiechters", search: "Fiechter", cover: "the-fiechters.jpg", songs: { // cover: Inns & Taverns
        "Ancient Legends": ["Black Wolf's Inn", "Dwarven Mines", "Imperial Dynasty"],
        "Camelot": ["Camelot", "Castle Bard", "Timber Town", "Wild Boar's Inn"],
        "Creatures of Lore": ["Leprechaun's Hut"],
        "Elven Throne": ["High Elves of Waterfall Sanctuary"],
        "Elves, Fairies, and Merfolk": ["Secrets of the Deep", "Tree Dwellers"],
        "Enchanted Lands": ["Excalibur"],
        "Eyes of the Forest": ["Eyes of the Forest"],
        "Fairy Lore": ["Moonlit Wings"],
        "Fantasy Realm": ["Fairy Forest", "Secret of the Elves"],
        "Forest of Secrets": ["Pixie Wings"],
        "Inns & Taverns": ["Coral Shell Inn", "Fire Hearth Tavern", "Glowing Ember's Inn", "Ironshield Inn", "Ursa's Inn", "Wise Oak Tavern"],
        "Inns and Villages": ["Hooded Rogue Inn", "Merchant's Village", "Ninja Star Inn"],
        "Magical Creatures": ["Atlantis Reborn", "Mermaid Waters"],
        "Medieval Villages": ["Mirador"],
        "Medieval World": ["Brown Fox Kingdom"],
        "Spooky Halloween": ["Eternal Winter"],
        "The Tea House": ["Moonlit Sky"],
        "The Wandering Bard": ["The Wandering Bard"],
        "Waltz of Dreams": ["Autumn Folk"],
        "Winter Whispers": ["Blue Alpine Village", "Crystal Chimes", "Lost Village of Snow", "Medieval Whispers"],
        "World of Wonders": ["Cherry Blossoms", "Red Dragon's Inn"],
      } },
      { title: "TheFatRat", search: "TheFatRat", cover: "thefatrat.jpg", songs: { // cover: Warrior Songs
        "Jackpot": ["Epic"],
        "PARALLAX": ["Fire", "Hiding In The Blue", "Let Love Win"],
        "Ray Tracer": ["P.S.", "Ray Tracer"],
        "Warrior Songs": ["Envelope", "Origin", "Origin Reprise", "Threnody", "Warrior Song"],
        "Singles": [
          "Close To The Sun", "Escaping Gravity", "Fly Away", "Ghost Light", "HONK", "MAYDAY", "Monody",
          "Myself & I (Orchestral Version)", "Never Be Alone (Michael Jan Remix)", "No No No", "Out Of The Rain",
          "Pride & Fear", "Sail Away", "Solitude", "Still Here With You", "The Calling", "Unity", "We'll Meet Again", "Windfall",
        ],
      } },
      { title: "YOASOBI", search: "YOASOBI", cover: "yoasobi.jpg", songs: { // cover: THE BOOK
        "THE BOOK": [
          ["あの夢をなぞって", "Tracing That Dream"], ["たぶん", "Probably"], ["ハルカ", "Haruka"], ["ハルジオン", "Halzion"],
          ["夜に駆ける", "Racing into the Night"],
        ],
        "THE BOOK 2": [["ツバメ", "The Swallow"], ["ラブレター", "Love Letter"], ["三原色", "Primary Colours"]],
        "E-SIDE": ["Comet"],
        "E-SIDE 2": ["Haruka", "Love Letter", "The Swallow"],
        "Hajimete no": [["セブンティーン", "Seventeen"]],
      } },
      { title: "Two Steps from Hell", search: "Two Steps from Hell", cover: "two-steps-from-hell.jpg", songs: ["Evergreen", "Heart of Courage", "Star Sky", "Victory"] }, // cover: Battlecry
    ],
  },
];
const abc = (a: string, b: string) => a.localeCompare(b, "en", { numeric: true });
const english = (s: Song) => (typeof s === "string" ? s : s[1]);
for (const g of groups) {
  g.items.sort((a, b) => abc(a.title, b.title));
  for (const item of g.items) {
    const sortSongs = (songs: Song[]) => songs.sort((a, b) => abc(english(a), english(b)));
    if (Array.isArray(item.songs)) sortSongs(item.songs);
    else if (item.songs) item.songs = Object.fromEntries(
      Object.entries(item.songs).sort(([a], [b]) => abc(a, b)).map(([h, songs]) => [h, sortSongs(songs)]));
  }
}
---
<Layout title="Music" hidden back={["/interests/", "Interests"]}>
  <p class="lede">Easter egg! For when you want to explore different feelings.</p>
  <div class="albums"><MediaGrid groups={groups} /></div>
</Layout>

<style>
  .lede { line-height: 1.7; text-wrap: pretty; }
  /* fixed tiles a quarter bigger than the ~7.2rem ones the shared grid stretches to on a full-width page */
  .albums :global(.picks) { grid-template-columns: repeat(auto-fill, 9rem); }
</style>
