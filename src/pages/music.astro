      { title: "Geometry Dash", cover: "geometry-dash.jpg", songs: { // cover: Geometry Dash app icon
        "RobTop Levels": ["Deadlocked", "Electroman Adventures", "Geometrical Dominator", "Hexagon Force", "The Seven Seas"],
        // [song, the extreme demon it's from]
        "Extreme Demons": [
          ["At the Speed of Light", "Bloodbath"], ["Dark Dragon Fire", "Avernus"], ["Dark Matter Suite", "Dark Odyssey"],
          ["Epilogue", "Acu"], ["Flamewall", "Flamewall"], ["Flow", "Nullscapes"], ["Iron God: Sakupen Hell Yes", "Sakupen Hell"],
