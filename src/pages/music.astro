        "Singles": ["Adventure (Remaster)", "Adventure Beyond", "Tavern Loop Three", "The Longest Journey"],
      } },
      { title: "Alan Walker", search: "Alan Walker", cover: "alan-walker.jpg", songs: { // cover: Alan Walker logo, public domain, via Wikimedia Commons
        "Different World": ["Darkside", "Faded", "Lily", "Sing Me to Sleep"],
