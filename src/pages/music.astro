      } },
      { title: "Minecraft OST", search: "Minecraft", cover: "minecraft-ost.jpg", songs: { // cover: Minecraft – Volume Alpha by C418
        "Volume Alpha": ["Danny", "Haggstrom", "Mice on Venus", "Minecraft", "Moog City", "Subwoofer Lullaby"],
        "Volume Beta": ["Alpha", "Aria Math", "Concrete Halls", "Haunt Muskie"],
        "Nether Update": ["Rubedo"],
        "Caves & Cliffs": ["Comforting Memories", "Left to Bloom", "One More Day", "otherside"],
        "Trails & Tales": ["Crescent Dunes"],
