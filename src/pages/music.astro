      { title: "20th Century Classics", cover: "20th-century-classics.jpg", songs: { // cover: "Shure Unidyne 55S" by Adam Lusch, CC BY-SA 2.0, via Wikimedia Commons
        "ABBA": ["Dancing Queen"],
        "Eurythmics": ["Sweet Dreams (Are Made of This)"],
        "Frank Sinatra": ["Fly Me to the Moon", "My Way", "The World We Knew"],
        "George Michael": ["Careless Whisper"],
        "Grover Washington Jr. & Bill Withers": ["Just the Two of Us"],
        "Louis Armstrong": ["What a Wonderful World"],
        "Modern Talking": ["Brother Louie", "Cheri Cheri Lady"],
        "Tears for Fears": ["Everybody Wants to Rule the World"],
