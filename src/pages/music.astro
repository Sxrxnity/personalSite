        "New Super Mario Bros. Wii": ["Ghost House", "Staff Roll", "World 1", "World 2"],
        "Yoshi's Island": ["Flower Garden"],
      } },
      { title: "MightyW Project", search: "MightyW Project", cover: "mightyw-project.jpg", songs: { // cover: Steel for the Morning, Flame for the Night
        "The Hollow Path": ["Ashes of the Wren"],
        "Songs from the Borderlands": ["Salt in the Wound, Salt in the Sea"],
        "Steel for the Morning, Flame for the Night": ["By Blade, By Bone", "Crownless", "Knight of the Hollow Star", "The Banner Will Burn"],
      } },
      { title: "Alexander Nakarada", search: "Alexander Nakarada", cover: "alexander-nakarada.jpg", songs: { // cover: Fantasy Fair
        "Fantasy Fair": [
          "Adventure", "Dungeons and Dragons", "Forest Walk", "Highland Song", "Lullaby", "Mountain Walk",
          "Now We Ride", "Nowhere Land", "Safe Haven", "Shelter Song", "Tavern Loop One", "Village Ambiance",
        ],
        "Maximus Melodius Harmonicus": ["Lively Tavern"],
