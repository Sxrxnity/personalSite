---
<Layout title="Media" hidden back={["/interests/", "Interests"]}>
  <p class="lede">
    Easter Egg! This page contains media which has made me feel or think in novel ways. Highly recommend.
  </p>
  <div class="rows"><MediaGrid groups={groups} /></div>
</Layout>

<script>
  // Each row drifts left on a loop, like a carousel: the tiles are repeated once so the row can jump back by exactly
  // one set without a visible seam. Every other row runs the opposite way. It stops while hovered or touched, so it
  // can still be browsed and scrolled by hand.
  const SPEED = 30; // px per second
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>(".rows .picks").forEach((row, r) => {
      const dir = r % 2 ? -1 : 1;
      const tiles = [...row.children];
      for (const tile of tiles) {
        const copy = tile.cloneNode(true) as HTMLElement;
        // the repeat still clicks through like the original, but isn't tabbed to or read out twice
        copy.setAttribute("aria-hidden", "true");
        copy.querySelectorAll("a, button").forEach((el) => el.setAttribute("tabindex", "-1"));
        row.append(copy);
      }
      let paused = false, pos = -1, last = performance.now();
      const hold = () => { paused = true; };
      const resume = () => { paused = false; pos = row.scrollLeft; };
      row.addEventListener("pointerenter", hold);
      row.addEventListener("pointerleave", resume);
      row.addEventListener("focusin", hold);
      row.addEventListener("focusout", resume);
      row.addEventListener("touchstart", hold, { passive: true });
      row.addEventListener("touchend", () => setTimeout(resume, 2000));
      const step = (now: number) => {
        const set = (row.children[tiles.length] as HTMLElement).offsetLeft - (tiles[0] as HTMLElement).offsetLeft;
        if (pos < 0) pos = dir > 0 ? 0 : set; // a backwards row starts on the repeat, so it has room to run
        if (!paused) {
          pos += dir * SPEED * (now - last) / 1000;
          if (pos >= set) pos -= set;
          if (pos < 0) pos += set;
          row.scrollLeft = pos;
        } else if (row.scrollLeft >= set) row.scrollLeft -= set; // hand-scrolled into the repeat: hop back
        last = now;
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }
</script>

<style>
  /* the whole page, top bar aside (it stays Georgia), in Barlow Condensed, like the music page */
  :global(main) { font-family: "Barlow Condensed", "Arial Narrow", sans-serif; }
  .lede { line-height: 1.7; text-wrap: pretty; }
  /* each category is one row that scrolls sideways, instead of wrapping into a block */
  .rows :global(.picks) {
    grid-auto-flow: column;
    grid-template-columns: none;
    grid-auto-columns: 9rem;
    overflow-x: auto;
    scrollbar-width: none; /* it moves by itself; still scrollable by trackpad, wheel or swipe */
  }
</style>
