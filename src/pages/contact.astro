---
import Layout from '../layouts/Layout.astro';

const links = [
  {
    href: "https://www.instagram.com/_sxrxnity_/",
    label: "Instagram",
    blurb: "If you're interested in my quotes",
    icon: "instagram",
    brand: "#d62976",
  },
  {
    href: "https://www.linkedin.com/in/danny-sun-b6521a223/",
    label: "LinkedIn",
    blurb: "If you're curious to see what I've been up to career wise",
    icon: "linkedin",
    brand: "#0a66c2",
  },
  {
    href: "https://mail.google.com/mail/?view=cm&to=dannysun420@gmail.com",
    label: "Gmail",
    blurb: "If you wish to shoot me a message",
    icon: "gmail",
    brand: "#ea4335",
  },
];
---
<Layout title="Contact Me">
  <div class="cards">
    {links.map((l) => (
      <a class="card" href={l.href} style={`--brand: ${l.brand}`}
        {...(l.href.startsWith("http") && { target: "_blank", rel: "noopener noreferrer" })}>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-width="1.8"
          stroke={l.icon === "instagram" ? "url(#ig-brand)" : l.brand}>
          {l.icon === "instagram" && (
            <>
              <!-- Instagram's brand gradient, yellow bottom-left to purple top-right -->
              <defs>
                <linearGradient id="ig-brand" gradientUnits="userSpaceOnUse" x1="3" y1="21" x2="21" y2="3">
                  <stop offset="0" stop-color="#feda75" />
                  <stop offset="0.25" stop-color="#fa7e1e" />
                  <stop offset="0.5" stop-color="#d62976" />
                  <stop offset="0.75" stop-color="#962fbf" />
                  <stop offset="1" stop-color="#4f5bd5" />
                </linearGradient>
              </defs>
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.3" cy="6.7" r="0.6" fill="url(#ig-brand)" />
            </>
          )}
          {l.icon === "linkedin" && (
            <>
              <rect x="3" y="3" width="18" height="18" rx="3" />
              <path d="M8 10.5V16M8 7.6v.1M11.5 16v-5.5M11.5 13c0-1.6 1-2.6 2.3-2.6s2.2.9 2.2 2.6V16" stroke-linecap="round" />
            </>
          )}
          {l.icon === "gmail" && (
            <>
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="M3.5 6.5 12 13l8.5-6.5" stroke-linejoin="round" />
            </>
          )}
        </svg>
        <div>
          <h2>{l.label}</h2>
          <p>{l.blurb}</p>
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .cards {
    display: grid;
    gap: 1.25rem;
  }
  .card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--wash);
    text-decoration: none;
    transition: border-color 0.2s, background-color 0.2s;
  }
  /* hover tints the box with its brand colour */
  .card:hover,
  .card:focus-visible {
    border-color: var(--brand);
    background: color-mix(in srgb, var(--brand) 10%, var(--paper));
  }
  .icon {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
  }
  .card h2 { margin: 0 0 0.25rem; }
  .card p { margin: 0; }
</style>
